# Settings for the local stack (compose.yaml). Credentials are deliberately absent:
# infra/local/init-env.sh writes infra/local/.env with random ones for this machine.
# Copy any of the settings below into that .env to override a default.

# Chain (Groot testnet until a local chain exists, ADR 0014). Groot's own testnet host has
# been down since 2026-10-18; tsuriai.jp:4013 serves testnet (docs/qpq-q-and-a.md).
NODE_URL=http://groot.testnet.gajumaru.io:3013
NODE_HOST_PORT=groot.testnet.gajumaru.io:3013
# contracts/networks/<name>.json the tx-builder image is built for; "build" until #71 deploys Platform
CONTRACTS_NETWORK=build

# Evidence bucket
S3_BUCKET=evidence

# Host ports (bound to 127.0.0.1)
API_PORT=8000
POSTGRES_PORT=5432
S3_PORT=7070
BAO_PORT=8200
