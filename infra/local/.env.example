# Copy to infra/local/.env to override the local stack's defaults (compose.yaml).
# Every value here is a throwaway development default; never reuse one anywhere else.

# Chain (Groot testnet until a local chain exists, ADR 0014)
NODE_URL=http://groot.testnet.gajumaru.io:3013
NODE_HOST_PORT=groot.testnet.gajumaru.io:3013
# contracts/networks/<name>.json the tx-builder image is built for; "build" until #71 deploys Platform
CONTRACTS_NETWORK=build

# PostgreSQL: superuser, and one role per service (ADR 0013)
POSTGRES_PASSWORD=postgres-local
API_DB_PASSWORD=api-local
INDEXER_DB_PASSWORD=indexer-local

# Evidence store (S3-compatible, object lock)
S3_ACCESS_KEY=gajufreight
S3_SECRET_KEY=gajufreight-local-secret
S3_BUCKET=evidence

# OpenBao dev-mode root token
BAO_TOKEN=root-local

# Host ports (bound to 127.0.0.1)
API_PORT=8000
POSTGRES_PORT=5432
S3_PORT=7070
BAO_PORT=8200
