# Settings for the local stack (compose.yaml). Credentials are deliberately absent:
# infra/local/init-env.sh writes infra/local/.env with random ones for this machine.
# Every setting below shows its default; uncomment one in that .env to change it.

# Chain (Groot testnet until a local chain exists, ADR 0014). The default is tsuriai.jp:4013,
# as Groot's own testnet host has been down since 2026-10-18 (docs/qpq-q-and-a.md):
# NODE_URL=http://tsuriai.jp:4013
# NODE_HOST_PORT=tsuriai.jp:4013
# contracts/networks/<name>.json the tx-builder image is built for; "build" until #71 deploys Platform
# CONTRACTS_NETWORK=build

# Evidence bucket
# S3_BUCKET=evidence

# Host ports (bound to 127.0.0.1)
# API_PORT=8000
# POSTGRES_PORT=5432
# S3_PORT=7070
# BAO_PORT=8200
