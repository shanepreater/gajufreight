// shipment-escrow.aes: one instance per shipment, and one per subcontracted leg. Booked only
// by Platform.book, which clones this template (ADR 0011).
@compiler >= 9

include "List.aes"
include "String.aes"

// The quote's agreed terms, stored on-chain in full (decision log #4). The escrow reads them
// once at booking and books exactly that record (ADR 0004, ADR 0011).
contract interface QuoteRequest =
  record terms =
    { price     : int                 // puck (10¹⁸ puck = 1 Gaju, Q3)
    , schedule  : list(string * int)  // milestones: (location, pct), paid in order
    , deadline  : int                 // block height; the payer can reclaim after it
    , attestors : list(address)
    , panel     : list(address)       // arbiters
    , quorum    : int                 // M of the N arbiters must agree
    , window    : int                 // arbitration window, in blocks
    , fallback  : int                 // payee's % if the window passes without a quorum
    , challenge : int }               // blocks to dispute a delivery made without a code (ADR 0006)
  entrypoint agreement : () => option(address * address * terms * hash)  // requester, payee, terms, job
  record fees =                                 // fixed when requested (ADR 0018, 0022)
    { fee_bps : int, min_fee : int, bond_bps : int, confirm_window : int, arbiter_fee_bps : int
    , min_arbiter_fee : int, deposit_window : int, treasury : address }
  entrypoint parent    : () => option(address)  // the main escrow, for a leg quote (ADR 0010)
  entrypoint fees      : () => fees

payable contract ShipmentEscrow =

  record milestone = { location : string, pct : int, paid : bool }

  // Unconfirmed until the payee confirms with its bond (ADR 0018).
  // DisputeFlagged: an attestor flagged a consignee's problem; awaiting the shipper's deposit.
  datatype status = Unconfirmed | Funded | InTransit | Delivered | DisputeFlagged | Disputed
                  | Released | Refunded | Resolved

  datatype kind = Milestone | ScanIn | ScanOut | Delivery

  // Extra charges after booking (ADR 0020): proposed by the payee, paid straight through when
  // the payer accepts, never held. At most max_charges per escrow, so the map stays bounded.
  datatype charge_kind = Demurrage | Detention | Waiting | Redelivery | Duty | Other
  datatype charge_status = Proposed | Accepted | Declined
  record charge = { kind : charge_kind, amount : int, evidence : hash, status : charge_status }

  // The indexer never reads live state: it rebuilds each escrow from the booking's call data,
  // the quote's agreed terms (on-chain in full), these events, and evidence-store preimages
  // (ADR 0013). So every state change and every payout emits one. Checkpoints are events
  // only. Event fields can't carry a datatype or an option, hence the codes.
  datatype event =
      Booked(address, address, hash)               // quote, payee, job hash
    | CheckpointAdded(address, int, hash, string)  // attestor, kind code, evidence, location
    | StatusChanged(string)
    | MilestonePaid(string, int)                   // location, amount
    | Voted(address, int)                          // arbiter, payee %
    | Settled(int, int)                            // payee's share, payer's share
    | RefundPaid(int)                              // unpaid remainder returned to the payer
    | Confirmed(int, int)                          // bond staked, fee taken from it (ADR 0018)
    | Cancelled(address)                           // who called off the unconfirmed booking
    | FeePaid(address, int)                        // treasury, amount
    | BondReleased(int, int)                       // held bond: to the payee, to the payer
    | AttestorAdded(address)                       // ADR 0006
    | AttestorRemovalApproved(address, address)    // attestor, first of payer and payee
    | AttestorRemoved(address)
    | ChargeProposed(int, int, int)                // id, kind code, amount (ADR 0020); evidence in the call data
    | ChargeAccepted(int, int)                     // id, amount paid to the payee
    | ChargeDeclined(int)
    | DisputeRaised(address, int)                  // raiser, deposit (ADR 0022)
    | Flagged(address, hash)                       // attestor, evidence: a dispute for the consignee
    | DisputeLapsed
    | ArbiterPaid(address, int)                    // a voting arbiter's share of the fee
    | DepositReturned(address, int)
    | DepositForfeited(address, int)               // to the other side, never to arbiters

  record state =
    { shipper      : address              // the payer: the shipper, or the forwarder for a leg
    , carrier      : address              // the payee: the forwarder, or a leg's carrier
    , consignee    : option(address)      // None when the final-mile proof is the proof (#8)
    , terms        : QuoteRequest.terms   // as agreed; read-only from here on
    , arbiters     : map(address, bool)
    , attestors    : map(address, bool)
    , max_attestors : int                 // the platform limit at booking, for add_attestor
    , removals     : map(address, address)  // attestor → who approved removing it first
    , votes        : map(address, int)
    , disputed_at  : int
    , delivered_at : int                  // when a delivery without a code started its window
    , manifest     : hash                 // hash of the package list (ADR 0003); stays off-chain
    , schedule     : list(milestone)      // paid by an attestor: ScanIn at a place, Milestone at an event label
    , paid_out     : int                  // paid so far; disputes and refunds act on the rest
    , to_payee     : int                  // paid to the payee so far
    , fee          : int                  // the platform fee, fixed at booking; 0 for a leg
    , bond         : int                  // what the payee stakes to confirm (ADR 0018)
    , confirm_by   : int                  // last block the payee can confirm
    , treasury     : address
    , parent       : option(address)      // the main escrow, if this is a leg
    , charges      : map(int, charge)     // extra charges by id (ADR 0020)
    , confirmed    : bool                 // the payee confirmed; a cancelled booking never was
    , arbiter_fee_bps : int               // fixed when requested (ADR 0022)
    , min_arbiter_fee : int
    , deposit_window  : int               // key blocks to fund a flagged dispute
    , deposit      : int                  // the raiser's deposit, equal to the arbiter fee
    , raiser       : address              // who staked the deposit (the shipper until a dispute)
    , prior        : status               // where a lapsed flag returns to
    , flagged_at   : int
    , status       : status }

  // Cloned and funded by Platform.book in one call (ADR 0005, 0011). The platform is the
  // caller, so the payer comes as `shipper`, and the platform's limits come as arguments:
  // calling back into the platform during its own call would be re-entrant. Funding is read
  // from Contract.balance: in init, Call.value is 0 (spike E2b).
  entrypoint init(shipper : address, quote : QuoteRequest, manifest : hash,
                  consignee : option(address), max_panel : int, max_attestors : int,
                  max_price : int) : state =
    require(Call.caller == platform(), "NOT_PLATFORM")
    let (payee, t) =
      switch(quote.agreement(value = 0, gas = 20000))
        None => abort("NOT_AGREED")
        Some((requester, counterparty, agreed, job)) =>
          // Agreed by this payer, for this shipment: a quote can't be reused for another one.
          require(requester == shipper && job == Crypto.blake2b((manifest, consignee)),
                  "NOT_AGREED")
          (counterparty, agreed)
    require(t.price > 0, "BAD_AMOUNT")
    require(max_price == 0 || t.price =< max_price, "OVER_LIMIT")  // pilot cap (ADR 0011)
    require(valid_schedule(t.schedule), "BAD_SCHEDULE")
    require(t.deadline > Chain.block_height && t.window > 0 && t.challenge > 0, "BAD_DEADLINE")
    let arbiters = Map.from_list(List.map((a) => (a, true), t.panel))
    require(List.length(t.panel) =< max_panel && Map.size(arbiters) == List.length(t.panel)
            && t.quorum >= 1 && t.quorum =< List.length(t.panel), "BAD_QUORUM")
    require(List.all((a) => a != shipper && a != payee && Some(a) != consignee, t.panel),
            "CONFLICTED_ARBITER")
    let attestors = Map.from_list(List.map((a) => (a, true), t.attestors))
    require(List.length(t.attestors) =< max_attestors, "BAD_ATTESTORS")
    require(!Map.member(payee, attestors), "CONFLICTED_ATTESTOR")  // no payee pays itself (ADR 0006)
    require(t.fallback >= 0 && t.fallback =< 100, "BAD_SPLIT")
    // A payout to a non-payable contract fails and burns the gas (spike E6b).
    require(Address.is_payable(shipper) && Address.is_payable(payee), "NOT_PAYABLE_PARTY")
    // Voting arbiters are paid at settlement, so a non-payable one would block it (ADR 0022).
    require(List.all(Address.is_payable, t.panel), "NOT_PAYABLE_PARTY")
    let f = quote.fees(value = 0, gas = 10000)
    require(Address.is_payable(f.treasury), "BAD_TREASURY")
    // The payer funds exactly the price; the payee stakes the bond when it confirms. A leg's
    // fee terms are 0, so its bond is bond_bps alone (ADR 0018).
    require(Contract.balance == t.price, "WRONG_AMOUNT")
    let parent = quote.parent(value = 0, gas = 10000)
    let fee = fee_due(f.fee_bps, f.min_fee, t.price)
    let performance = t.price * f.bond_bps / 10000
    Chain.event(Booked(quote.address, payee, Crypto.blake2b((manifest, consignee))))
    { shipper = shipper, carrier = payee, consignee = consignee, terms = t,
      arbiters = arbiters, attestors = attestors, max_attestors = max_attestors,
      removals = {}, votes = {}, disputed_at = 0, delivered_at = 0, manifest = manifest,
      schedule = List.map((m) => switch(m) (l, p) => { location = l, pct = p, paid = false },
                          t.schedule),
      paid_out = 0, to_payee = 0, fee = fee,
      bond = if (fee > performance) fee else performance,
      confirm_by = Chain.block_height + f.confirm_window, treasury = f.treasury,
      parent = parent, charges = {}, confirmed = false, arbiter_fee_bps = f.arbiter_fee_bps,
      min_arbiter_fee = f.min_arbiter_fee, deposit_window = f.deposit_window, deposit = 0,
      raiser = shipper, prior = Unconfirmed, flagged_at = 0, status = Unconfirmed }  // funded at creation: no Created state, no fund()

  // The payee commits by staking the bond. The fee goes to the treasury now, so it is paid
  // however the shipment ends; the rest is held until it does (ADR 0018).
  payable stateful entrypoint confirm() =
    require(Call.caller == state.carrier, "ONLY_PAYEE")
    require(state.status == Unconfirmed, "BAD_STATE")
    require(Chain.block_height =< state.confirm_by, "CONFIRM_EXPIRED")
    require(Call.value == state.bond, "WRONG_AMOUNT")
    put(state{ status = Funded, confirmed = true })
    Chain.event(StatusChanged("Funded"))
    Chain.event(Confirmed(state.bond, state.fee))
    if (state.fee > 0)
      Chain.event(FeePaid(state.treasury, state.fee))
    pay(state.treasury, state.fee)

  // Before confirmation either side can walk away: the payer gets the price back and no fee
  // is charged, because the payee never committed. Nothing is paid out or held yet.
  stateful entrypoint cancel_booking() =
    require(Call.caller == state.shipper || Call.caller == state.carrier, "UNAUTHORIZED")
    require(state.status == Unconfirmed, "BAD_STATE")
    Chain.event(Cancelled(Call.caller))
    refund_remainder()

  // One call per location: the evidence bundle lists every package scanned there.
  stateful entrypoint add_checkpoint(location : string, kind : kind, evidence : hash) =
    require(is_attestor(Call.caller) || Call.caller == state.carrier, "UNAUTHORIZED")
    require(is_open(), "BAD_STATE")
    require(kind != Delivery, "BAD_KIND")  // delivery only via confirm_delivery
    put(state{ status = InTransit })
    Chain.event(CheckpointAdded(Call.caller, kind_code(kind), evidence, location))
    // Only an attestor fires a milestone (the payee can't pay itself): a scan-in for a place,
    // a milestone checkpoint for an event label (ADR 0020).
    if (is_attestor(Call.caller) && pays_milestone(kind, location))
      release_milestone(location)

  // The consignee, or an attestor whose delivery code matched with every package delivered,
  // releases at once. Any other attestor delivery holds the remainder for the challenge
  // window, so the shipper, or an attestor's flag for the consignee, can dispute it (ADR 0006,
  // ADR 0022). Delivery
  // may be confirmed after the deadline until a refund is claimed: the first call wins.
  stateful entrypoint confirm_delivery(evidence : hash, code_checked : bool) =
    let by_consignee = Some(Call.caller) == state.consignee
    require(by_consignee || is_attestor(Call.caller), "UNAUTHORIZED")
    require(is_open(), "BAD_STATE")
    Chain.event(CheckpointAdded(Call.caller, kind_code(Delivery), evidence, "DELIVERED"))
    if (by_consignee || code_checked)
      release_remainder()
    else
      put(state{ status = Delivered, delivered_at = Chain.block_height })
      Chain.event(StatusChanged("Delivered"))

  // After an unchallenged window, anyone can release the held remainder: it can't freeze.
  stateful entrypoint release_after_window() =
    require(state.status == Delivered, "BAD_STATE")
    require(Chain.block_height > state.delivered_at + state.terms.challenge, "CHALLENGE_OPEN")
    release_remainder()

  // The payer or payee raises a dispute while the goods move (once a delivery is held, only
  // the payer), staking a deposit equal to the arbiter fee; a flagged dispute can be raised by
  // either within the deposit window (ADR 0022). The consignee never pays or signs: its
  // problem comes through the final-mile agent's flag.
  payable stateful entrypoint raise_dispute() =
    require(Call.caller == state.shipper || Call.caller == state.carrier, "UNAUTHORIZED")
    let flagged = state.status == DisputeFlagged
    let at = if (flagged) state.prior else state.status  // where the goods are
    require(is_open() || state.status == Delivered || flagged, "BAD_STATE")
    require(at != Delivered || Call.caller != state.carrier, "UNAUTHORIZED")
    require(!flagged || Chain.block_height =< state.flagged_at + state.deposit_window,
            "DEPOSIT_EXPIRED")
    require(state.paid_out < state.terms.price, "NOTHING_DISPUTED")
    require(Call.value == deposit_due(), "WRONG_AMOUNT")
    start_dispute(Call.caller)

  // An attestor (the final-mile agent, ADR 0006) flags a consignee's problem. Nothing moves
  // until the shipper (or the forwarder) raises it with the deposit, or the flag lapses.
  stateful entrypoint flag_dispute(evidence : hash) =
    require(is_attestor(Call.caller), "UNAUTHORIZED")
    require(is_open() || state.status == Delivered, "BAD_STATE")
    require(state.flagged_at == 0, "ALREADY_FLAGGED")  // once only, so flags can't freeze funds
    require(state.paid_out < state.terms.price, "NOTHING_DISPUTED")
    put(state{ prior = state.status, flagged_at = Chain.block_height, status = DisputeFlagged })
    Chain.event(Flagged(Call.caller, evidence))
    Chain.event(StatusChanged("DisputeFlagged"))

  // An unfunded flag lapses and the shipment carries on where it was; a held delivery's
  // challenge clock is not reset.
  stateful entrypoint lapse_dispute() =
    require(state.status == DisputeFlagged, "BAD_STATE")
    require(Chain.block_height > state.flagged_at + state.deposit_window, "DEPOSIT_WINDOW_OPEN")
    put(state{ status = state.prior })
    Chain.event(DisputeLapsed)
    Chain.event(StatusChanged(status_name(state.prior)))

  // What raising a dispute costs now: the arbiter fee on the unpaid remainder (ADR 0022).
  entrypoint deposit_due() : int =
    let left = state.terms.price - state.paid_out
    let pct = left * state.arbiter_fee_bps / 10000
    let fee = if (pct > state.min_arbiter_fee) pct else state.min_arbiter_fee
    if (fee < left) fee else left

  // A later vote replaces the arbiter's earlier one; the dispute settles as soon as
  // `quorum` arbiters hold the same split (ADR 0002).
  stateful entrypoint vote(pay_carrier_pct : int) =
    require(Map.member(Call.caller, state.arbiters), "ONLY_ARBITER")
    require(state.status == Disputed, "BAD_STATE")
    require(pay_carrier_pct >= 0 && pay_carrier_pct =< 100, "BAD_SPLIT")
    put(state{ votes[Call.caller] = pay_carrier_pct })
    Chain.event(Voted(Call.caller, pay_carrier_pct))
    if (votes_for(pay_carrier_pct) >= state.terms.quorum)
      settle(pay_carrier_pct)

  // Deadlock or absent panel: after the window anyone involved applies the fallback.
  stateful entrypoint resolve_by_fallback() =
    require(is_party(Call.caller) || Map.member(Call.caller, state.arbiters), "UNAUTHORIZED")
    require(state.status == Disputed, "BAD_STATE")
    require(Chain.block_height > state.disputed_at + state.terms.window, "ARBITRATION_OPEN")
    settle(state.terms.fallback)

  stateful entrypoint refund_after_deadline() =
    require(Call.caller == state.shipper, "ONLY_SHIPPER")
    require(is_open(), "BAD_STATE")
    require(Chain.block_height > state.terms.deadline, "NOT_EXPIRED")
    refund_remainder()

  // The payee gives up its claim to the unpaid remainder (ADR 0011): it can only give away
  // its own money, so it needs no one else's consent.
  stateful entrypoint release_to_payer() =
    require(Call.caller == state.carrier, "ONLY_PAYEE")
    require(is_open() || state.status == Delivered, "BAD_STATE")
    refund_remainder()

  // Adding an attestor can only release the payer's own money, so the payer alone can do
  // it; never the payee (ADR 0006).
  stateful entrypoint add_attestor(a : address) =
    require(Call.caller == state.shipper, "ONLY_SHIPPER")
    require(is_open(), "BAD_STATE")
    require(a != state.carrier, "CONFLICTED_ATTESTOR")
    require(!is_attestor(a) && Map.size(state.attestors) < state.max_attestors, "BAD_ATTESTORS")
    put(state{ attestors[a] = true })
    Chain.event(AttestorAdded(a))

  // Removal needs both payer and payee, in either order (ADR 0006, decision log #3).
  stateful entrypoint remove_attestor(a : address) =
    require(Call.caller == state.shipper || Call.caller == state.carrier, "UNAUTHORIZED")
    require(is_open(), "BAD_STATE")
    require(is_attestor(a), "NOT_ATTESTOR")
    switch(Map.lookup(a, state.removals))
      None =>
        put(state{ removals[a] = Call.caller })
        Chain.event(AttestorRemovalApproved(a, Call.caller))
      Some(first) =>
        require(first != Call.caller, "ALREADY_APPROVED")
        put(state{ attestors = Map.delete(a, state.attestors),
                   removals = Map.delete(a, state.removals) })
        Chain.event(AttestorRemoved(a))

  // The payee proposes a charge with evidence; allowed once confirmed, even after the escrow
  // ends, because port storage is often billed after delivery (ADR 0020).
  stateful entrypoint propose_charge(kind : charge_kind, amount : int, evidence : hash) : int =
    require(Call.caller == state.carrier, "ONLY_PAYEE")
    require(state.confirmed, "BAD_STATE")
    require(amount > 0, "BAD_AMOUNT")
    let id = Map.size(state.charges)
    require(id < max_charges(), "TOO_MANY_CHARGES")
    put(state{ charges[id] = { kind = kind, amount = amount, evidence = evidence,
                               status = Proposed } })
    Chain.event(ChargeProposed(id, charge_code(kind), amount))
    id

  // The payer accepts and pays in one call; the charge passes straight to the payee with no
  // platform fee, so the escrow's own funds are untouched.
  payable stateful entrypoint accept_charge(id : int) =
    require(Call.caller == state.shipper, "ONLY_SHIPPER")
    let c = open_charge(id)
    require(Call.value == c.amount, "WRONG_AMOUNT")
    put(state{ charges[id].status = Accepted })
    Chain.event(ChargeAccepted(id, c.amount))
    pay(state.carrier, c.amount)

  // A declined charge stays on record and is settled off-chain (ADR 0020).
  stateful entrypoint decline_charge(id : int) =
    require(Call.caller == state.shipper, "ONLY_SHIPPER")
    open_charge(id)
    put(state{ charges[id].status = Declined })
    Chain.event(ChargeDeclined(id))

  entrypoint charge(id : int) : option(charge) = Map.lookup(id, state.charges)

  // Read by the platform, and by anyone checking an escrow.
  entrypoint price() : int = state.terms.price
  entrypoint payee() : address = state.carrier
  entrypoint is_open() : bool = state.status == Funded || state.status == InTransit
  entrypoint is_leg() : bool = state.parent != None
  entrypoint is_terminal() : bool =
    state.status == Released || state.status == Refunded || state.status == Resolved
  entrypoint paid_to_payee() : int = state.to_payee
  entrypoint get_status() : status = state.status

  stateful function release_remainder() =
    let remaining = state.terms.price - state.paid_out
    let held = held_bond()
    put(state{ status = Released, paid_out = state.terms.price })
    Chain.event(StatusChanged("Released"))
    pay_payee(remaining)
    pay_held_bond(held, 100)

  stateful function refund_remainder() =
    let remaining = state.terms.price - state.paid_out
    let held = held_bond()
    put(state{ status = Refunded, paid_out = state.terms.price })
    Chain.event(StatusChanged("Refunded"))
    Chain.event(RefundPaid(remaining))
    pay(state.shipper, remaining)
    pay_held_bond(held, 0)

  stateful function start_dispute(raiser : address) =
    put(state{ status = Disputed, disputed_at = Chain.block_height, deposit = Call.value,
               raiser = raiser })
    Chain.event(StatusChanged("Disputed"))
    Chain.event(DisputeRaised(raiser, Call.value))

  // Splits only what hasn't been paid; paid milestones are final. Voting arbiters share the
  // fee whichever way they ruled; it comes off the remainder before the split, rounding staying
  // in the split. The deposit goes back to a raiser who won at least half, otherwise to the
  // other side, never to the arbiters (ADR 0022).
  stateful function settle(pct : int) =
    let remaining = state.terms.price - state.paid_out
    let voters = List.map((v) => switch(v) (a, _) => a, Map.to_list(state.votes))
    let n = List.length(voters)
    let share = if (n == 0) 0 else state.deposit / n
    let pool = remaining - share * n
    let to_carrier = pool * pct / 100
    let held = held_bond()
    let raiser = state.raiser
    let raiser_won = if (raiser == state.carrier) pct >= 50 else 100 - pct >= 50
    let other_side = if (raiser == state.carrier) state.shipper else state.carrier
    let deposit_to = if (raiser_won) raiser else other_side
    let deposit = state.deposit
    put(state{ status = Resolved, paid_out = state.terms.price, deposit = 0 })
    Chain.event(StatusChanged("Resolved"))
    Chain.event(Settled(to_carrier, pool - to_carrier))
    pay_arbiters(voters, share)
    pay_payee(to_carrier)
    pay(state.shipper, pool - to_carrier)
    if (deposit > 0)
      if (raiser_won) Chain.event(DepositReturned(deposit_to, deposit))
      else Chain.event(DepositForfeited(deposit_to, deposit))
    pay(deposit_to, deposit)
    pay_held_bond(held, pct)

  // Bounded by the panel size (max_panel).
  stateful function pay_arbiters(voters : list(address), share : int) =
    switch(voters)
      [] => ()
      a :: rest =>
        if (share > 0)
          Chain.event(ArbiterPaid(a, share))
        pay(a, share)
        pay_arbiters(rest, share)

  // Pays the next unpaid milestone, once, and only at its own location. Each pays its
  // cumulative share minus what's already paid, so rounding lands on the last payout.
  stateful function release_milestone(location : string) =
    switch(List.find((m) => !m.paid, state.schedule))
      None => ()
      Some(next) =>
        if (next.location == location)
          let reached = List.sum(List.map((m) => m.pct, List.filter((m) => m.paid, state.schedule))) + next.pct
          let due = state.terms.price * reached / 100 - state.paid_out
          let marked = List.map((x) => if (x.location == location) x{ paid = true } else x, state.schedule)
          put(state{ schedule = marked, paid_out = state.paid_out + due })
          Chain.event(MilestonePaid(location, due))
          pay_payee(due)

  // Payouts to the payee carry no fee: it came out of the bond at confirmation (ADR 0018).
  stateful function pay_payee(amount : int) =
    put(state{ to_payee = state.to_payee + amount })
    pay(state.carrier, amount)

  // The bond above the fee, held from confirmation until the escrow ends. Nothing runs after
  // a terminal status, so it can't be paid twice (ADR 0018).
  function held_bond() : int = if (state.status == Unconfirmed) 0 else state.bond - state.fee

  // When the escrow ends, the held bond splits like the outcome: pct% back to the payee, the
  // rest (and any rounding) to the payer as compensation. Spends only.
  stateful function pay_held_bond(held : int, pct : int) =
    let to_payee = held * pct / 100
    if (held > 0)
      Chain.event(BondReleased(to_payee, held - to_payee))
    pay(state.carrier, to_payee)
    pay(state.shipper, held - to_payee)

  // Every value transfer goes through here. Zero amounts are skipped: a zero spend would
  // create an empty account or fail on a contract (spike E12).
  stateful function pay(to : address, amount : int) =
    if (amount > 0)
      Chain.spend(to, amount)

  // A percentage of the price with a minimum, never more than 10% of the price: a limit fixed
  // here, not a setting, so no vote can raise it (ADR 0018).
  function fee_due(bps : int, min : int, price : int) : int =
    let pct = price * bps / 10000
    let fee = if (pct > min) pct else min
    let cap = price * 1000 / 10000
    if (fee < cap) fee else cap

  // The canonical Platform for this network, substituted into the template at build time
  // (an `ak_…` literal of the platform's address). Never caller-supplied.
  function platform() : address = PLATFORM_ADDRESS

  function max_charges() : int = 20

  // A lapsed flag can return to any of these; the indexer reads it from StatusChanged.
  function status_name(st : status) : string =
    switch(st)
      Funded    => "Funded"
      InTransit => "InTransit"
      Delivered => "Delivered"
      _         => "Other"

  function open_charge(id : int) : charge =
    switch(Map.lookup(id, state.charges))
      None    => abort("NO_CHARGE")
      Some(c) =>
        require(c.status == Proposed, "CHARGE_CLOSED")
        c

  function charge_code(k : charge_kind) : int =
    switch(k)
      Demurrage  => 0
      Detention  => 1
      Waiting    => 2
      Redelivery => 3
      Duty       => 4
      Other      => 5

  // A label with a colon (CUSTOMS:NLRTM, ONBOARD:CNYTN) is an attested event, paid by an
  // attestor's milestone checkpoint; any other label is a place, paid by a scan-in (ADR 0020).
  function pays_milestone(k : kind, location : string) : bool =
    if (String.contains(location, ":") != None) k == Milestone else k == ScanIn

  function kind_code(k : kind) : int =
    switch(k)
      Milestone => 0
      ScanIn    => 1
      ScanOut   => 2
      Delivery  => 3

  function is_attestor(a : address) : bool = Map.member(a, state.attestors)
  function is_party(a : address) : bool =
    a == state.shipper || a == state.carrier || Some(a) == state.consignee
  // Each 1..100, unique places, total ≤ 100. A continuation line can't start with && in
  // Sophia 9, so each line ends with it.
  function valid_schedule(s : list(string * int)) : bool =
    List.all((m) => switch(m) (_, p) => p >= 1 && p =< 100, s) &&
      List.sum(List.map((m) => switch(m) (_, p) => p, s)) =< 100 &&
      Map.size(Map.from_list(s)) == List.length(s)
  function votes_for(pct : int) : int =  // bounded by the panel size
    List.length(List.filter((v) => switch(v) (_, p) => p == pct, Map.to_list(state.votes)))
