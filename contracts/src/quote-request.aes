// quote-request.aes: one per shipment request, and one per subcontracted leg. Cloned by
// Platform.new_quote, which passes the real requester and its current settings. It never
// holds money (ADR 0004). Invited forwarders quote; the requester counters and accepts
// (ADR 0015).
@compiler >= 9

include "List.aes"

contract QuoteRequest =

  // Every term that moves money, stored on-chain in full in each quote (ADR 0011, decision
  // log #4), so both sides, and anyone later, can read exactly what was agreed.
  record terms =
    { price     : int
    , schedule  : list(string * int)
    , deadline  : int
    , attestors : list(address)
    , panel     : list(address)
    , quorum    : int
    , window    : int
    , fallback  : int
    , challenge : int }

  // What the forwarders are asked to price: public, so no personal data (ADR 0015). Sizes in
  // mm and weights in grams; places are location codes (UN/LOCODE), never a street address.
  // The goods manifest and the consignee stay off-chain, as the job hash.
  record unit_line = { count : int, length_mm : int, width_mm : int, height_mm : int, weight_g : int }
  record consignment =
    { units : list(unit_line), origin : string, destination : string, deliver_by : option(int) }

  datatype status = Open | Agreed | Withdrawn
  record offer = { terms : terms, valid_until : int, round : int }
  // One invitee's negotiation: its latest quote, the requester's unanswered counter (target
  // price and an optional note hash), how many counters so far, and whether it declined.
  record thread =
    { quote : option(offer), counter : option(int * option(hash)), counters : int
    , declined : bool }

  // Event fields can't carry a record or an option: the indexer reads a quote's terms, and
  // any note's hash, from the call's data. The terms hash here identifies the terms.
  datatype event =
      Quoted(address, hash, int)  // invitee, terms hash, round
    | Countered(address, int)     // invitee, target price
    | Declined(address)           // invitee
    | Accepted(address, hash)     // invitee, terms hash
    | RequestWithdrawn

  record state =
    { requester   : address
    , invited     : map(address, bool)
    , job         : hash                  // blake2b((manifest, consignee)); the escrow checks it
    , consignment : consignment
    , threads     : map(address, thread)
    , max_rounds  : int                   // counters per thread, from Platform when created
    , parent      : option(address)       // the main escrow, if this is a leg (ADR 0010)
    , fee_terms   : int * int * address   // fee_bps, min_fee, treasury when requested (ADR 0010)
    , status      : status
    , agreed      : option(address * terms) }

  entrypoint init(requester : address, invited : list(address), job : hash, c : consignment,
                  max_rounds : int, parent : option(address),
                  fee_terms : int * int * address) : state =
    require(invited != [] && !List.contains(requester, invited), "NOT_INVITED")  // no self-invites
    require(valid_consignment(c), "BAD_CONSIGNMENT")
    { requester = requester, invited = Map.from_list(List.map((a) => (a, true), invited)),
      job = job, consignment = c, threads = {}, max_rounds = max_rounds, parent = parent,
      fee_terms = fee_terms, status = Open, agreed = None }

  // An invited forwarder quotes full terms on its own thread: first, or in answer to the
  // requester's counter. The escrow checks the terms in full at booking; the app checks
  // them before building this call.
  stateful entrypoint quote(t : terms, valid_until : int) =
    require(Map.member(Call.caller, state.invited), "NOT_INVITED")
    require(state.status == Open, "BAD_STATE")
    let th = open_thread(Call.caller)
    require(th.quote == None || th.counter != None, "NOT_YOUR_TURN")
    require(valid_until > Chain.block_height, "OFFER_EXPIRED")
    let round = th.counters + 1
    put(state{ threads[Call.caller] = th{ quote = Some({ terms = t, valid_until = valid_until,
                                                          round = round }),
                                          counter = None } })
    Chain.event(Quoted(Call.caller, Crypto.blake2b(t), round))

  // The requester names a target price, with an optional note whose text stays off-chain.
  // The forwarder answers with a revised quote or declines. The answer to the last counter
  // allowed is final: it can only be accepted or left to lapse.
  stateful entrypoint counter(invitee : address, price : int, note : option(hash)) =
    require(Call.caller == state.requester, "ONLY_REQUESTER")
    require(Map.member(invitee, state.invited), "NOT_INVITED")
    require(state.status == Open, "BAD_STATE")
    let th = open_thread(invitee)
    require(th.quote != None && th.counter == None, "NOT_YOUR_TURN")
    require(th.counters < state.max_rounds, "ROUND_LIMIT")
    require(price > 0, "BAD_PRICE")
    put(state{ threads[invitee] = th{ counter = Some((price, note)), counters = th.counters + 1 } })
    Chain.event(Countered(invitee, price))

  // The requester accepts exactly the quote it saw, named by its hash; every other thread
  // closes.
  stateful entrypoint accept(invitee : address, terms_hash : hash) =
    require(Call.caller == state.requester, "ONLY_REQUESTER")
    require(Map.member(invitee, state.invited), "NOT_INVITED")
    require(state.status == Open, "BAD_STATE")
    let th = open_thread(invitee)
    let o = switch(th.quote)
      None => abort("NO_OFFER")
      Some(x) => x
    require(th.counter == None, "NOT_YOUR_TURN")
    require(Crypto.blake2b(o.terms) == terms_hash, "TERMS_CHANGED")
    require(Chain.block_height =< o.valid_until, "OFFER_EXPIRED")
    put(state{ status = Agreed, agreed = Some((invitee, o.terms)) })
    Chain.event(Accepted(invitee, terms_hash))

  // An invited forwarder steps out, with an optional reason whose text stays off-chain. Its
  // thread closes; the others carry on.
  stateful entrypoint decline(note : option(hash)) =
    require(Map.member(Call.caller, state.invited), "NOT_INVITED")
    require(state.status == Open, "BAD_STATE")
    let th = open_thread(Call.caller)
    put(state{ threads[Call.caller] = th{ declined = true } })
    Chain.event(Declined(Call.caller))

  stateful entrypoint withdraw() =
    require(Call.caller == state.requester, "ONLY_REQUESTER")
    require(state.status == Open, "BAD_STATE")
    put(state{ status = Withdrawn })
    Chain.event(RequestWithdrawn)

  entrypoint agreement() : option(address * address * terms * hash) =
    switch(state.agreed)
      None => None
      Some((counterparty, t)) => Some((state.requester, counterparty, t, state.job))

  entrypoint consignment() : consignment = state.consignment
  entrypoint thread(invitee : address) : option(thread) = Map.lookup(invitee, state.threads)
  entrypoint is_final(invitee : address) : bool =
    switch(Map.lookup(invitee, state.threads))
      None => false
      Some(th) => th.quote != None && th.counter == None && th.counters == state.max_rounds
  entrypoint parent() : option(address) = state.parent
  entrypoint fee_terms() : int * int * address = state.fee_terms

  // The invitee's thread, new if it has none yet; a declined thread takes no more moves.
  function open_thread(invitee : address) : thread =
    let th = Map.lookup_default(invitee, state.threads,
                                { quote = None, counter = None, counters = 0, declined = false })
    require(!th.declined, "THREAD_CLOSED")
    th

  // The list is capped, so this loop is bounded; the requester pays for it.
  function valid_consignment(c : consignment) : bool =
    let n = List.length(c.units)
    let in_time = switch(c.deliver_by)
      None => true
      Some(h) => h > Chain.block_height
    n > 0 && n =< 20 && c.origin != "" && c.destination != "" && in_time
      && List.all(valid_line, c.units)

  function valid_line(u : unit_line) : bool =
    u.count > 0 && u.length_mm > 0 && u.width_mm > 0 && u.height_mm > 0 && u.weight_g > 0
